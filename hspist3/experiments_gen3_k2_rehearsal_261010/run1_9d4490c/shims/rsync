#!/bin/bash
# rehearsal shim (added during the run, before the fetch step; 261012 sec. 4.7.47): the fetch's rsync with "--exclude=e0_*/" added, so
# the gate folder's E0 outputs (afix/afix_leg event logs, 206 MB) are not copied a second time (the 500 MB data budget); every other
# file goes through /usr/bin/rsync with the fetch script's own arguments
echo "[rehearsal rsync shim] /usr/bin/rsync --exclude=e0_*/ $*" >&2
exec /usr/bin/rsync "--exclude=e0_*/" "$@"
