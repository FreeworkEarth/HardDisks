#!/bin/bash
# ##CHRIS 2026-10-13: Paper 1 confinement campaign, method B (free divider, A1v2 protocol), group B_0.39.
# Generated by cluster/gen_confinement_sbatch.py from the pre-registered cell list (261012 sec. 1). NOT LAUNCHED.
# One array task = one cell (cells_B_0.39.tsv line N); the cell's trajectories run 8 at a time.
# FILLED 2026-10-02 (Task K1): partition shared, account uh, scratch /mnt/lustre/koa/scratch/charing (koa_scratch:
# files are DELETED 90 days after last write -- copy results back before then). Submit from ~/harddisks/hspist3 after
# `mkdir -p logs`; the binary must already be built by cluster/koa_smoketest.sh (this job does not build).
#   sbatch --array=1-9 cluster/confinement_20261013/conf_B_0.39.sbatch
#SBATCH --job-name=conf-B_0.39
#SBATCH --partition=shared
#SBATCH --account=uh
#SBATCH --time=1:00:00
#SBATCH --cpus-per-task=8
#SBATCH --mem=8G
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.out
set -uo pipefail
SCRATCH="/mnt/lustre/koa/scratch/charing"
cd "$SLURM_SUBMIT_DIR"                       # hspist3/ (source, scripts, the koa-built binary)
source cluster/koa_env.sh || exit 1
export HD_BIN="$PWD/00ALLINONE" HD_DATA="$SCRATCH/harddisks/hspist3"
gcc --version | head -1; "$HD_BIN" --version | head -2
"$HD_BIN" --version | head -1 | grep -q -- "git $(git rev-parse --short HEAD)  target koa" || { echo "STOP: not the clean koa build of HEAD"; exit 1; }
CELL=$(sed -n "${SLURM_ARRAY_TASK_ID}p" cluster/confinement_20261013/cells_B_0.39.tsv)
TASKS=cluster/confinement_20261013/tasks_B_$CELL.txt
echo "cell $CELL: $(wc -l < "$TASKS") trajectories, 8 in parallel"
xargs -P 8 -L 1 bash cluster/confinement_20261013/conf_worker.sh < "$TASKS"
python3 cluster/confinement_20261013/reduce_B.py "$HD_DATA/experiments_speed_of_sound/EDMD/mode1_normalized_units/00_eta_sweep_ROMAN/confinement_B_20261013/$CELL"
echo "cell $CELL done; failures: $(grep -c FAILED logs/conf-B_0.39_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.out || true)"
