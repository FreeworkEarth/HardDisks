#!/bin/bash
# ##CHRIS 2026-10-04 (Task Y2): Paper 1 confinement campaign, "A-fixed" (261012 sec. 3): method A with the divider HELD for
# the whole record (--wall-hold-steps=312000, --steps=1200), group Afix_0.10. Generated by cluster/gen_afix_sbatch_261004.py from
# the method-A task files (same cells, positions, seeds). NOT LAUNCHED. Output: $HD_DATA/experiments_energy_transfer/paper1_confinement_Afix_261004/ (new; method-A dirs untouched).
# One array task = one cell (cells_Afix_0.10.tsv line N); the cell's trajectories run 16 at a time.
# Partition shared, account uh, scratch /mnt/lustre/koa/scratch/charing (files DELETED 90 days after last write).
# Submit from ~/harddisks/hspist3 after `mkdir -p logs`; the binary must be the recorded build (logs/BUILD_KOA_LAST.hash).
#   sbatch --array=1-10%2 cluster/confinement_20261013/conf_Afix_0.10.sbatch      (runsheet step 9 for --time overrides)
#SBATCH --job-name=conf-Afix_0.10
#SBATCH --partition=shared
#SBATCH --account=uh
#SBATCH --time=0:30:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=8G
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.out
set -uo pipefail
SCRATCH="/mnt/lustre/koa/scratch/charing"
cd "$SLURM_SUBMIT_DIR"                       # hspist3/ (source, scripts, the koa-built binary)
source cluster/koa_env.sh || exit 1
export HD_BIN="$PWD/00ALLINONE" HD_DATA="$SCRATCH/harddisks/hspist3"
gcc --version | head -1; "$HD_BIN" --version | head -2
[ -s logs/BUILD_KOA_LAST.hash ] || { echo "STOP: no logs/BUILD_KOA_LAST.hash -- build with cluster/build_koa.sh first"; exit 1; }
sha256sum --status -c logs/BUILD_KOA_LAST.hash || { echo "STOP: ./00ALLINONE is not the build recorded in logs/BUILD_KOA_LAST.hash"; exit 1; }
export HD_BUILD="$("$HD_BIN" --version | head -1)"
echo "$HD_BUILD" | grep -Eq -- "git [0-9a-f]+  target koa" || { echo "STOP: not a clean koa build: $HD_BUILD"; exit 1; }
CELL=$(sed -n "${SLURM_ARRAY_TASK_ID}p" cluster/confinement_20261013/cells_Afix_0.10.tsv)
TASKS=cluster/confinement_20261013/tasks_AF_$CELL.txt
echo "cell $CELL: $(wc -l < "$TASKS") trajectories, 16 in parallel"
xargs -P 16 -L 1 bash cluster/confinement_20261013/conf_worker.sh < "$TASKS"
echo "A-fixed: per-seed red_<seed>.csv written by the worker (reduce_AF.py, held window [200, 5200))"
echo "cell $CELL done; failures: $(grep -c FAILED logs/conf-Afix_0.10_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.out || true)"
