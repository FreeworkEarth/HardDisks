#!/bin/bash
# ##CHRIS 2026-10-13: Paper 1 confinement campaign, method A (held divider), group A_pilot.
# Generated by cluster/gen_confinement_sbatch.py from the pre-registered cell list (261012 sec. 1). NOT LAUNCHED.
# One array task = one cell (cells_A_pilot.tsv line N); the cell's trajectories run 16 at a time.
# FILL BEFORE SUBMITTING (KOA runbook): __PARTITION__ (shared: 3 d, by core), __ACCOUNT__, __SCRATCH__ (koa_scratch:
# files are DELETED 90 days after last write -- copy results back before then).
#   sbatch --array=1-1 cluster/confinement_20261013/conf_A_pilot.sbatch
#SBATCH --job-name=conf-A_pilot
#SBATCH --partition=__PARTITION__
#SBATCH --account=__ACCOUNT__
#SBATCH --time=1:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=8G
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.out
set -uo pipefail
SCRATCH="__SCRATCH__"
cd "$SLURM_SUBMIT_DIR"                       # hspist3/ (source, scripts, the koa-built binary)
export HD_BIN="$PWD/00ALLINONE" HD_DATA="$SCRATCH/harddisks/hspist3"
"$HD_BIN" --version | head -2
CELL=$(sed -n "${SLURM_ARRAY_TASK_ID}p" cluster/confinement_20261013/cells_A_pilot.tsv)
TASKS=cluster/confinement_20261013/tasks_A_$CELL.txt
echo "cell $CELL: $(wc -l < "$TASKS") trajectories, 16 in parallel"
xargs -P 16 -L 1 bash cluster/confinement_20261013/conf_worker.sh < "$TASKS"
echo "method A: per-seed red_<seed>.csv written by the worker"
echo "cell $CELL done; failures: $(grep -c FAILED logs/conf-A_pilot_${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}.out || true)"
